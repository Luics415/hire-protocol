{
  "id": "wfWhatsAppBot01",
  "name": "Bot Bidireccional de WhatsApp - Asistente de Postulaciones",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-command",
        "responseMode": "responseNode",
        "options": {}
      },
